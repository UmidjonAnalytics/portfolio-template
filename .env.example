# Copy this file to .env.local and fill in the values from
# Firebase Console -> Project settings -> Your apps -> SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Comma-separated list of emails allowed into /admin (must ALSO be in firestore.rules + storage.rules).
NEXT_PUBLIC_ADMIN_EMAILS=you@example.com

# Where uploaded images/CV are kept:
#   auto      -> use Firebase Storage if a bucket is configured, otherwise Firestore (default)
#   storage   -> always Firebase Storage (needs the Blaze plan on new projects)
#   firestore -> always store compressed files inside Firestore (free plan friendly)
NEXT_PUBLIC_MEDIA_MODE=auto

# Public URL of the deployed site (used for SEO / Open Graph). Optional.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Set to "true" only on YOUR OWN deployment: enables the customer intake form at /forma
# and Admin -> Buyurtmalar. Leave it unset on every customer site. See INTAKE.md.
NEXT_PUBLIC_INTAKE_ENABLED=false

# Set to "true" only for local development against the Firebase Emulator Suite.
NEXT_PUBLIC_USE_EMULATORS=false

# Only used by `npm run seed` / `npm run seed:clear` (command-line seeding). Never exposed to the browser.
SEED_EMAIL=
SEED_PASSWORD=
